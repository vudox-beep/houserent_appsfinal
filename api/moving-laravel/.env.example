APP_NAME="HouseRent Moving API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://houseforrent.site/api/moving-laravel/public

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Same MySQL database as house/config/config.php (users, drivers, moving_* tables).
# Leave DB_* empty on cPanel to auto-read from house/config/config.php.
# Do NOT run default Laravel migrations against this production database.
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# Optional. Leave empty to allow open mode (same as Node default).
# If set, Flutter MovingMarketplaceService.apiSharedSecret must match.
API_SHARED_SECRET=

# Google Maps key for the /api/v1/maps proxy (autocomplete, geocoding).
# Optional — when empty, Laravel reads GOOGLE_MAPS_API_KEY from house/config/config.php
# (same file the website uses). Only set this to override that config file.
GOOGLE_MAPS_API_KEY=

# Same JWT secret as php_backend login tokens (Bearer auth on /api/v1/*).
JWT_SECRET=

# Optional if JSON is already on the server for FCM push (same path).
# Leave empty when php_backend/config/firebase-service-account.json exists.
FIREBASE_CREDENTIALS=


SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
